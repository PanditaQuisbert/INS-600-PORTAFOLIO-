# ============================================
# STUDIO MORA - Variables de Entorno
# ============================================
# Copia este archivo como .env y completa los valores
# NO subas este archivo a git (ya está en .gitignore)
# ============================================

# ---------- INFORMACIÓN GENERAL ----------
VITE_APP_NAME="Studio Mora"
VITE_APP_TAGLINE="Creative Developer & Designer"
VITE_APP_DESCRIPTION="Portafolio creativo con estilo neo-brutalist"
VITE_APP_VERSION="2.0.0"

# ---------- CONTACTO ----------
VITE_APP_EMAIL="hola@studiomora.dev"
VITE_APP_EMAIL_SUPPORT="soporte@studiomora.dev"
VITE_APP_PHONE="+34612345678"
VITE_APP_WHATSAPP="34612345678"
VITE_APP_LOCATION="Madrid, España"

# ---------- REDES SOCIALES ----------
VITE_SOCIAL_GITHUB="https://github.com/studiomora"
VITE_SOCIAL_LINKEDIN="https://linkedin.com/in/studiomora"
VITE_SOCIAL_TWITTER="https://twitter.com/studiomora"
VITE_SOCIAL_INSTAGRAM="https://instagram.com/studiomora"
VITE_SOCIAL_DRIBBBLE="https://dribbble.com/studiomora"
VITE_SOCIAL_BEHANCE="https://behance.net/studiomora"

# ---------- SERVICIOS EXTERNOS ----------
# Formulario de contacto (Formspree)
VITE_FORMSPREE_ENDPOINT="https://formspree.io/f/your-form-id"

# Google Analytics (opcional)
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Google Maps API Key (opcional)
VITE_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# EmailJS (para envío de correos)
VITE_EMAILJS_SERVICE_ID="your-service-id"
VITE_EMAILJS_TEMPLATE_ID="your-template-id"
VITE_EMAILJS_PUBLIC_KEY="your-public-key"

# ---------- CONFIGURACIÓN ----------
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_ANIMATIONS=true
VITE_ENABLE_CURSOR_CUSTOM=true
VITE_DEFAULT_LANGUAGE="es"
VITE_TIMEZONE="Europe/Madrid"

# ---------- SEO ----------
VITE_SITE_URL="https://studiomora.dev"
VITE_SITE_IMAGE="https://studiomora.dev/og-image.jpg"
VITE_TWITTER_HANDLE="@studiomora"

# ---------- ENTORNO ----------
NODE_ENV=development
VITE_API_URL=http://localhost:3000/api
VITE_CMS_URL=https://api.contentful.com/spaces/your-space

# ---------- SEGURIDAD ----------
# NO COMPARTAS ESTAS CLAVES
VITE_SECRET_KEY="change-this-to-a-random-secret-key"
VITE_API_TOKEN="your-api-token-here"